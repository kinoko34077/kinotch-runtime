{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kinoko34077/kinotch-runtime/contracts/execution/result.schema.json",
  "title": "KiNoTch Action Result",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "success",
        "partial",
        "failed",
        "cancelled"
      ]
    },
    "data": {},
    "error": {
      "$ref": "error.schema.json"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "artifact.schema.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
